# ==============================================================================
# Avigo Oil and Gas Integrated Ltd. - Environment Configuration Template
# Copy this file to .env before starting the production server.
# ==============================================================================

# HTTP Port (defaults to 3000)
PORT=3000

# Node execution environment (production / development)
NODE_ENV=production

# Custom URL path for the executive admin portal (defaults to /avigo-portal)
# NOTE: Standard routes like /admin, /login, /dashboard automatically return 404.
AVIGO_PORTAL_PATH=/avigo-portal

